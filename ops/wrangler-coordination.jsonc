{
  "name": "streamlion-client-coordination",
  "main": "client-coordination.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "vars": {
    "ENABLE_CLIENT_COORDINATION": "false",
    "ENABLE_RESEND_EMAIL": "false",
    "ENABLE_WEB_PUSH": "false",
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "GOOGLE_SESSIONS",
      "database_name": "streamlion-google-sessions",
      "database_id": "f9945b40-00ca-4662-9113-585927e31ec0",
    },
  ],
}
