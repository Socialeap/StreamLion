{
  "name": "streamlion-client-coordination",
  "main": "client-coordination.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "ENABLE_CLIENT_COORDINATION": "true",
    "COORDINATION_SCHEDULER_ORIGIN": "https://streamlion.transcendencemedia.com",
    "STREAMLION_PAYMENTS_MODE": "test",
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
