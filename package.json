{
  "name": "streamlion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "pretest": "npm run build:extension",
    "preview": "vite preview --host 127.0.0.1",
    "preview:extension": "npm run build:extension && node scripts/preview-extension.mjs",
    "preview:coordination": "node scripts/preview-coordination.mjs",
    "test": "node --import tsx --test src/*.test.js src/*.test.jsx functions/**/*.test.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:extension": "node scripts/smoke-extension.mjs",
    "verify:capacity": "node scripts/verify-capacity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.63.4",
    "esbuild": "npm:esbuild-wasm@0.28.2",
    "sharp": "0.35.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
