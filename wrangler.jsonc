{
  "name": "streamlion",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "production": {
      "vars": {
        "ENABLE_CHATGPT_EXTENSION": "true",
        "ENABLE_AI_PILOT": "true",
        "ENABLE_CLIENT_COORDINATION": "true",
        "ENABLE_RESEND_EMAIL": "true",
        "ENABLE_WEB_PUSH": "true",
        "ENABLE_COORDINATION_METRICS": "false",
        "COORDINATION_RECONCILE_SECONDS": "60",
        "COORDINATION_POLL_SECONDS": "15",
        "COORDINATION_CLEANUP_SECONDS": "3600",
        "RESEND_DAILY_LIMIT": "20",
        "RESEND_TEST_DAILY_LIMIT": "40",
        "RESEND_TEST_DAILY_LIMIT_UNTIL": "2026-10-12T04:00:00.000Z",
        "RESEND_MONTHLY_LIMIT": "500",
      },
      "d1_databases": [
        {
          "binding": "GOOGLE_SESSIONS",
          "database_name": "streamlion-google-sessions",
          "database_id": "f9945b40-00ca-4662-9113-585927e31ec0",
          "migrations_dir": "migrations",
        },
      ],
    },
    "preview": { "d1_databases": [] },
  },
}
