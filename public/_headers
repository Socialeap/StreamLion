/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin
  Permissions-Policy: microphone=(self), camera=(self), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' https://accounts.google.com https://sheets.googleapis.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com https://docs.google.com https://drive.google.com; frame-ancestors 'self' https://chatgpt.com https://*.openai.com https://*.oaiusercontent.com; base-uri 'self'; object-src 'none'; form-action 'self'

/release.json
  Cache-Control: no-store

/sw.js
  Cache-Control: no-cache

/client/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/coordination/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/api/client-portal*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/api/client-requests*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
